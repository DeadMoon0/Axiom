<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!--<GenerateDocumentationFile>true</GenerateDocumentationFile>--><!--//TODO: Add this later-->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>Axiom.State</Title>
		<Authors>DeadMoon0</Authors>
		<Product>Axiom</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>State,Management,Redux,Rx,Axiom</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>A predictable, type-safe State Management System for C# built on the Observable Pattern. Manage application state with StateActions, Reducers, Effects, and Selectors for consistent and reactive state changes.</Description>
		<Version>0.3.5</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/Axiom</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/Axiom.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType> 
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>Rework the Effect System, Bug fixes</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Assets\Icon.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="Actions\StateAction.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>StateAction.tt</DependentUpon>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Linq.Async" Version="7.0.1" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Actions\StateAction.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>StateAction.tt</DependentUpon>
		</Compile>
		<Compile Update="Actions\StateActionAsync.cs">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>StateActionAsync.tt</DependentUpon>
		</Compile>
		<Compile Update="Effects\EffectsGen.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>EffectsGen.tt</DependentUpon>
		</Compile>
		<Compile Update="Reducers\ReducerScopeGen.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>ReducerScopeGen.tt</DependentUpon>
		</Compile>
		<Compile Update="Store\StateStoreGen.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>StateStoreGen.tt</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Actions\StateAction.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>StateAction.cs</LastGenOutput>
		</None>
		<None Update="Actions\StateActionAsync.tt">
		  <Generator>TextTemplatingFileGenerator</Generator>
		  <LastGenOutput>StateActionAsync.cs</LastGenOutput>
		</None>
		<None Update="Effects\EffectsGen.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>EffectsGen.cs</LastGenOutput>
		</None>
		<None Update="README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Update="Reducers\ReducerScopeGen.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>ReducerScopeGen.cs</LastGenOutput>
		</None>
		<None Update="Store\StateStoreGen.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>StateStoreGen.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>
