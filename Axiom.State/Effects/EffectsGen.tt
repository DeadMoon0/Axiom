<#+

string GenericTypes(int count)
{
    if(count == 0) return "";
    return "<" + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i}")) + ">";
}

string GenericTypesNoBracets(int count, bool prefix = true, bool sufix = false)
{
    if(count == 0) return "";
    return (prefix ? ", " : "") + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i}")) + (sufix ? ", " : "");
}

string GenericTypesResult(int count)
{
    if(count == 0) return "<TResult>";
    return "<TResult, " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i}")) + ">";
}

string Argumens(int count)
{
    if (count == 0) return "";
    return ", " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i} arg{i}"));
}

string ArgumensFromArray(int count)
{
    if (count == 0) return "";
    return ", " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"(T{i})args[{i - 1}]!"));
}

string ArgumensNoType(int count, bool prefix = true)
{
    if (count == 0) return "";
    return (prefix ? ", " : "") + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"arg{i}"));
}

string ArgumensArray(int count)
{
    return ", [" + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"arg{i}")) + "]";
}

#>