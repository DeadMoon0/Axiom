<#+

string GenericTypes(int count)
{
    if(count == 0) return "";
    return "<" + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i}")) + ">";
}

string GenericTypesNoBracets(int count)
{
    if(count == 0) return "";
    return ", " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i}"));
}

string GenericTypesResult(int count)
{
    if(count == 0) return "<TResult>";
    return "<TResult, " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i}")) + ">";
}

string Argumens(int count)
{
    if (count == 0) return "";
    return ", " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"T{i} arg{i}"));
}

string ArgumensFromArray(int count)
{
    if (count == 0) return "";
    return ", " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"(T{i})args[{i}]!"));
}

string ArgumensNoType(int count)
{
    if (count == 0) return "";
    return ", " + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"arg{i}"));
}

string ArgumensArray(int count)
{
    return ", [" + string.Join(", ",
        Enumerable.Range(1, count).Select(i => $"arg{i}")) + "]";
}

#>