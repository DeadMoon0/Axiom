using System;
using System.Reactive.Linq;
using System.Reactive.Threading.Tasks;
using System.Threading.Tasks;

namespace Axiom.State.Effects;

public abstract partial class Effects<TState> where TState : struct
{
<#
const int MaxArity = 15;

for (int i = 0; i <= MaxArity; i++)
{
#>
    protected EffectResult<TState> Do<#= GenericTypes(i) #>(Actions.StateAction<#= GenericTypes(i) #> action<#= Argumens(i) #>) => new EffectSingleResult<TState>(action<#= ArgumensArray(i) #>);
    protected void On<#= GenericTypes(i) #>(Actions.StateAction<#= GenericTypes(i) #> action, Func<TState<#= GenericTypesNoBracets(i) #>, EffectResult<TState>> effect) => _handers.Add(new ActionEffect<TState>((s, args) => effect(s<#= ArgumensFromArray(i) #>)).GetHandler(action));
<#
    if(i != 15) {
#>
    protected void OnAsync<#= GenericTypesResult(i) #>(Actions.StateActionAsync<#= GenericTypesResult(i) #> stateAction, Func<TState <#= GenericTypesNoBracets(i) #>, Task<TResult>> action) => On(stateAction.BeginAction, (state<#= ArgumensNoType(i) #>) => DoAction(() => action(state<#= ArgumensNoType(i) #>), (x) => Do(stateAction.SuccessAction, x<#= ArgumensNoType(i) #>), e => Do(stateAction.ErrorAction, e<#= ArgumensNoType(i) #>)));
    protected void OnAsync<#= GenericTypes(i) #>(Actions.StateActionAsyncNoResult<#= GenericTypes(i) #> stateAction, Func<TState <#= GenericTypesNoBracets(i) #>, Task> action) => On(stateAction.BeginAction, (state<#= ArgumensNoType(i) #>) => DoAction(() => action(state<#= ArgumensNoType(i) #>), () => Do(stateAction.SuccessAction<#= ArgumensNoType(i) #>), e => Do(stateAction.ErrorAction, e<#= ArgumensNoType(i) #>)));
    protected EffectResult<TState> Await<#= GenericTypesResult(i) #>(Actions.StateActionAsync<#= GenericTypesResult(i) #> stateAction<#= Argumens(i) #>, bool isSuccessRequired = true) => new EffectAwaitableResult<TState>(Do(stateAction.BeginAction<#= ArgumensNoType(i) #>), stateAction.SuccessAction, stateAction.ErrorAction, isSuccessRequired);
    protected EffectResult<TState> Await<#= GenericTypes(i) #>(Actions.StateActionAsyncNoResult<#= GenericTypes(i) #> stateAction<#= Argumens(i) #>, bool isSuccessRequired = true) => new EffectAwaitableResult<TState>(Do(stateAction.BeginAction<#= ArgumensNoType(i) #>), stateAction.SuccessAction, stateAction.ErrorAction, isSuccessRequired);

<#
    }
#>
<#
}
